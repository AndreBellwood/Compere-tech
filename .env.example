# COMPèRE Environment Configuration Template
# Duplicate this file to .env and fill in your values

# LLM provider: "gemini" (default) or "anthropic" (direct Anthropic API)
LLM_PROVIDER=gemini

# --- Option A: Google Gemini (LLM_PROVIDER=gemini) ---
# Google AI Studio API Key (Obtain from https://aistudio.google.com/)
LLM_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API base URL for Google Gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Gemini Model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
LLM_MODEL=gemini-3.8-flash

# --- Option B: Direct Anthropic API (LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-5-5

# Beta Access Protection
# Optional passkey to gate beta access. Leave blank to allow public/frictionless access.
BETA_ACCESS_CODE=COMPERE-BETA-2026
